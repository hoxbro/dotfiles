#!/usr/bin/env bash

set -euxo pipefail

wait_for_clients() {
    local timeout=$1
    while ((timeout-- > 0)) && [[ $(hyprctl clients -j -i 0 | jq 'length') -gt 0 ]]; do
        sleep 0.1
    done
}

kill_remaining() {
    hyprctl clients -j -i 0 | jq -r '.[].pid' | sort -u | xargs -r kill "$1" || true
}

hypr_kill() {
    hyprctl clients -j -i 0 |
        jq -r ".[].address" |
        xargs -I{} hyprctl dispatch -i 0 "hl.dsp.window.close({ window = 'address:{}' })"
    wait_for_clients 50

    # Wine's explorer.exe /desktop and overlay windows ignore close requests
    kill_remaining -TERM
    wait_for_clients 30
    kill_remaining -KILL

    hyprctl dispatch -i 0 "hl.dsp.focus({ workspace = 1 })"
}

main() {
    selected="${1:-}"
    if [[ -z $selected ]]; then
        selected=$(echo -e "Shutdown\nReboot" | walker --dmenu)
    fi

    case "${selected,,}" in
    shutdown) hypr_kill && systemctl poweroff -i ;;
    reboot) hypr_kill && systemctl reboot -i ;;
    *) notify-send "hypr-kill" "Not a valid option: \"$selected\"" ;;
    esac
}

main "$@" || notify-send "hypr-kill" "Failed to execute"
