#!/usr/bin/env bash
set -uo pipefail

usage() {
    cat <<'EOF'
Usage: worktime <mode> [args]

Waybar custom/worktime module, dispatched by first argument (mode):
  status           (default, no args) streams the waybar text/tooltip JSON
  start            project/subproject/note picker (left-click)
  stop             ends the current timer (middle-click)
  shortcuts-menu   live GTK shortcuts popup (right-click)
EOF
}

WORKTIME_HOST="10.0.1.2:8000"
WORKTIME_BASE_URL="http://$WORKTIME_HOST"
WORKTIME_WS_URL="ws://$WORKTIME_HOST"
WORKTIME_PROJECTS_CACHE="$HOME/.cache/worktime/projects.json"
WORKTIME_NOTES_CACHE="$HOME/.cache/worktime/notes.json"
WORKTIME_NOTES_MAX=7
WORKTIME_RECENT_CACHE="$HOME/.cache/worktime/recent.json"
WORKTIME_RECENT_MAX=8

post() { curl -s --connect-timeout 5 -H "Content-Type: application/json" -X POST -d "$2" "$WORKTIME_BASE_URL$1"; }

# Kept current by the long-running status mode on every /ws/projects push.
worktime_fetch_projects() {
    jq -ce '.projects' "$WORKTIME_PROJECTS_CACHE" 2>/dev/null
}

worktime_fetch_shortcuts() {
    jq -ce '.shortcuts // []' "$WORKTIME_PROJECTS_CACHE" 2>/dev/null
}

write_projects_cache() {
    jq -e . >/dev/null 2>&1 <<<"$1" || return 0
    mkdir -p "$(dirname "$WORKTIME_PROJECTS_CACHE")"
    printf '%s\n' "$1" >"$WORKTIME_PROJECTS_CACHE.tmp" && mv -f "$WORKTIME_PROJECTS_CACHE.tmp" "$WORKTIME_PROJECTS_CACHE"
}

# Per project/subproject-combo note history (a plain JSON cache file, not
# a real database) - last WORKTIME_NOTES_MAX distinct notes used, newest
# first, so the picker can offer them again instead of retyping.
worktime_notes_key() {
    printf '%s|%s' "$1" "$2"
}

worktime_notes_history() {
    local key="$1"
    [[ -f "$WORKTIME_NOTES_CACHE" ]] || {
        echo '[]'
        return 0
    }
    jq -c --arg key "$key" '.[$key] // []' "$WORKTIME_NOTES_CACHE"
}

worktime_notes_record() {
    local key="$1" note="$2"
    [[ -z "$note" ]] && return 0
    mkdir -p "$(dirname "$WORKTIME_NOTES_CACHE")"
    [[ -f "$WORKTIME_NOTES_CACHE" ]] || echo '{}' >"$WORKTIME_NOTES_CACHE"
    jq --arg key "$key" --arg note "$note" --argjson max "$WORKTIME_NOTES_MAX" \
        '.[$key] = ([$note] + ((.[$key] // []) - [$note]))[0:$max]' \
        "$WORKTIME_NOTES_CACHE" >"$WORKTIME_NOTES_CACHE.tmp" && mv -f "$WORKTIME_NOTES_CACHE.tmp" "$WORKTIME_NOTES_CACHE"
}

# Last WORKTIME_RECENT_MAX unique (project, subproject, note) combos actually
# started with a note, newest first, so the shortcuts menu can offer quick
# re-starts of recent work alongside the server-configured shortcuts.
worktime_recent_record() {
    local project_id="$1" subproject_id="$2" note="$3"
    [[ -z "$note" ]] && return 0
    mkdir -p "$(dirname "$WORKTIME_RECENT_CACHE")"
    [[ -f "$WORKTIME_RECENT_CACHE" ]] || echo '[]' >"$WORKTIME_RECENT_CACHE"
    jq --arg pid "$project_id" --arg sid "$subproject_id" --arg note "$note" --argjson max "$WORKTIME_RECENT_MAX" \
        '([{project_id: $pid, subproject_id: $sid, note: $note}] +
          map(select(.project_id != $pid or .subproject_id != $sid or .note != $note)))[0:$max]' \
        "$WORKTIME_RECENT_CACHE" >"$WORKTIME_RECENT_CACHE.tmp" && mv -f "$WORKTIME_RECENT_CACHE.tmp" "$WORKTIME_RECENT_CACHE"
}

worktime_recent_list() {
    [[ -f "$WORKTIME_RECENT_CACHE" ]] || {
        echo '[]'
        return 0
    }
    jq -c '.' "$WORKTIME_RECENT_CACHE"
}

worktime_subproject_name() {
    local project_id="$1" subproject_id="$2" projects="$3"
    [[ -z "$subproject_id" || "$subproject_id" == "null" ]] && return 0
    jq -r --arg pid "$project_id" --arg sid "$subproject_id" \
        '(.[] | select(.id == $pid) | .subprojects[]? | select(.id == $sid) | .name) // $sid' \
        <<<"$projects"
}

notify_err() { notify-send "Worktime" "$1"; }

do_stop() {
    local response
    response=$(post "/worktime/stop" '{}')
    if [[ -z "$response" ]]; then
        notify_err "Failed to stop timer"
        exit 1
    fi
}

start_timer() {
    local project_id="$1" subproject_id="$2" label="$3" note="${4:-}" payload response
    payload=$(jq -nc --arg project_id "$project_id" --arg subproject "$subproject_id" --arg note "$note" \
        '{project_id: $project_id}
         + (if $subproject == "" then {} else {subproject: $subproject} end)
         + (if $note == "" then {} else {note: $note} end)')
    response=$(post "/worktime/start" "$payload")
    if [[ -z "$response" ]]; then
        notify_err "Failed to start $label"
        exit 1
    fi
}

# Waybar renders both text and tooltip as Pango markup, so any literal
# &/</> from a project/subproject name (e.g. "P&E") must be escaped or
# GTK silently rejects the markup and the module stops updating.
emit_status() {
    jq -nc --arg symbol "" --arg tooltip "$1" --arg class "$2" \
        'def esc: gsub("&"; "&amp;") | gsub("<"; "&lt;") | gsub(">"; "&gt;");
         {text: ($symbol | esc), tooltip: ($tooltip | esc), class: $class}'
}

# Globals set by the do_status loop, read by render_status.
state="" start="" note="" label="" project_id="" subproject="" connected=0

# Rerun on projects pushes too, so a name missing from the cache when the
# state arrived gets filled in once the projects message lands.
update_label() {
    local projects
    label="$state"
    [[ -z "$subproject" ]] && return 0
    projects=$(worktime_fetch_projects) || projects="[]"
    label="$state · $(worktime_subproject_name "$project_id" "$subproject" "$projects")"
}

render_status() {
    if [[ -z "$state" || "$state" == "idle" ]]; then
        if ((connected)); then
            emit_status "Idle" "idle"
        else
            emit_status "Idle (server down)" "stale"
        fi
        return 0
    fi

    local now start_epoch elapsed elapsed_fmt started_local tooltip
    now=$(date +%s)
    start_epoch=$(date -d "$start" +%s 2>/dev/null || echo "$now")
    elapsed=$((now - start_epoch))
    ((elapsed < 0)) && elapsed=0
    printf -v elapsed_fmt '%02d:%02d:%02d' $((elapsed / 3600)) $((elapsed % 3600 / 60)) $((elapsed % 60))
    started_local=$(date -d "$start" '+%H:%M' 2>/dev/null || echo "$start")

    tooltip="$label"$'\n'"$started_local · $elapsed_fmt"
    [[ -n "$note" ]] && tooltip="$note"$'\n'"$tooltip"

    if ((connected)); then
        emit_status "$tooltip" "running"
    else
        emit_status "$tooltip"$'\n'"⚠ stale (server unreachable)" "stale"
    fi
}

# Long-running: waybar runs this without an interval and reads one JSON line
# per update. State changes arrive over the websocket; the 1s read timeout
# only exists to tick the elapsed counter. On disconnect it exits and waybar's
# restart-interval reconnects, keeping the last (stale) line shown meanwhile.
do_status() {
    local fd pfd line rc
    # Pids stay global: the EXIT trap fires after do_status returns, when locals are gone.
    trap 'kill ${ws_pid:-} ${projects_pid:-} 2>/dev/null' EXIT
    trap 'exit 0' TERM INT

    # exec so WS_PID is websocat itself, not a subshell that would orphan it on kill.
    coproc WS { exec websocat -n -U "$WORKTIME_WS_URL/ws/current" 2>/dev/null; }
    # Bash unsets WS and WS_PID once the coproc exits, which trips set -u.
    fd=${WS[0]}
    # shellcheck disable=SC2153 # WS_PID is set by coproc
    ws_pid=$WS_PID

    # Bash supports only one coproc at a time.
    exec {pfd}< <(exec websocat -n -U "$WORKTIME_WS_URL/ws/projects" 2>/dev/null)
    projects_pid=$!

    while :; do
        # read -t 0 is also true at EOF, which the full read then reports.
        while read -t 0 -u "$pfd"; do
            IFS= read -r -u "$pfd" line || break 2
            write_projects_cache "$line"
            update_label
        done

        IFS= read -r -t 1 -u "$fd" line
        rc=$?
        if ((rc > 128)); then
            render_status
            continue
        fi
        ((rc == 0)) || break
        jq -e . >/dev/null 2>&1 <<<"$line" || continue

        connected=1
        state=$(jq -r '.state // "idle"' <<<"$line")
        project_id=$(jq -r '.project_id // empty' <<<"$line")
        subproject=$(jq -r '.subproject // empty' <<<"$line")
        start=$(jq -r '.start // empty' <<<"$line")
        note=$(jq -r '.note // empty' <<<"$line")
        update_label
        render_status
    done

    connected=0
    render_status
}

do_start() {
    local projects options=() choice project_id project subprojects default_subproject sub_count
    projects=$(worktime_fetch_projects) || {
        notify_err "No cached worktime projects yet"
        exit 1
    }

    while IFS= read -r name; do
        options+=("$name")
    done < <(jq -r '.[] | select(.hidden | not) | .name' <<<"$projects")

    choice=$(printf '%s\n' "${options[@]}" | walker --dmenu) || exit 0
    [[ -z "$choice" ]] && exit 0

    project_id=$(jq -r --arg name "$choice" '.[] | select(.name == $name) | .id' <<<"$projects" | head -n1)
    project=$(jq -c --arg name "$choice" '.[] | select(.name == $name)' <<<"$projects" | head -n1)
    subprojects=$(jq -c '.subprojects' <<<"$project")
    default_subproject=$(jq -r '.default_subproject // ""' <<<"$project")
    sub_count=$(jq 'length' <<<"$subprojects")

    local subproject_id="" sub_names sub_choice
    if ((sub_count > 0)); then
        # Default subproject (if set) listed first, rest in their normal order.
        sub_names=$(jq -r --arg def "$default_subproject" \
            '(map(select(.id == $def)) + map(select(.id != $def))) | .[].name' <<<"$subprojects")
        sub_choice=$(printf '%s\n' "$sub_names" | walker --dmenu) || exit 0
        [[ -z "$sub_choice" ]] && exit 0
        subproject_id=$(jq -r --arg name "$sub_choice" '.[] | select(.name == $name) | .id' <<<"$subprojects" | head -n1)
    fi

    local notes_key note
    notes_key=$(worktime_notes_key "$project_id" "$subproject_id")
    note=$(worktime_notes_history "$notes_key" | jq -r '.[]' | walker --dmenu --placeholder "Note (optional)") || note=""

    start_timer "$project_id" "$subproject_id" "$choice" "$note"
    worktime_notes_record "$notes_key" "$note"
    worktime_recent_record "$project_id" "$subproject_id" "$note"
}

do_shortcuts_menu() {
    local shortcuts recent projects combined count names choice entry project_id subproject_id note
    shortcuts=$(worktime_fetch_shortcuts) || {
        notify_err "No cached worktime projects yet"
        exit 1
    }
    projects=$(worktime_fetch_projects) || projects="[]"
    recent=$(worktime_recent_list)

    # Shortcuts first, then recent notes - labeled "note · project · subproject"
    # since, unlike shortcuts, they have no dedicated nickname.
    combined=$(jq -c -n --argjson shortcuts "$shortcuts" --argjson recent "$recent" --argjson projects "$projects" '
        def project_label(pid; sid):
            (($projects[] | select(.id == pid)) // {}) as $p |
            (($p.subprojects[]? | select(.id == sid) | .name) // empty) as $sub |
            [$p.name // pid] + (if $sub != "" then [$sub] else [] end) | join(" · ");
        ($shortcuts | map({label: .name, project_id, subproject: (.subproject // ""), note: .name})) +
        ($recent | map(. as $r |
            {label: ([$r.note, project_label($r.project_id; $r.subproject_id)] | join(" · ")),
             project_id: $r.project_id, subproject: $r.subproject_id, note: $r.note}))
    ')

    count=$(jq 'length' <<<"$combined")
    ((count == 0)) && exit 0

    names=$(jq -r '.[].label' <<<"$combined")
    choice=$(printf '%s\n' "$names" | ~/dotfiles/.config/waybar/scripts/menu.py 2>/dev/null) || exit 0
    [[ -z "$choice" ]] && exit 0

    entry=$(jq -c --arg label "$choice" '[.[] | select(.label == $label)] | .[0]' <<<"$combined")
    [[ -z "$entry" || "$entry" == "null" ]] && exit 0

    project_id=$(jq -r '.project_id' <<<"$entry")
    subproject_id=$(jq -r '.subproject // ""' <<<"$entry")
    note=$(jq -r '.note' <<<"$entry")

    start_timer "$project_id" "$subproject_id" "$choice" "$note"
}

mode="${1:-status}"
case "$mode" in
status) do_status ;;
start) do_start ;;
stop) do_stop ;;
shortcuts-menu) do_shortcuts_menu ;;
*)
    usage >&2
    notify_err "Unknown worktime mode: $mode"
    exit 1
    ;;
esac
