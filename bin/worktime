#!/usr/bin/env bash
set -uo pipefail

usage() {
    cat <<'EOF'
Usage: worktime <mode> [args]

Waybar custom/worktime module, dispatched by first argument (mode):
  status           (default, no args) emits the waybar text/tooltip JSON
  start            project/subproject/note picker (left-click)
  stop             ends the current timer (middle-click)
  shortcuts-menu   live GTK shortcuts popup (right-click)
EOF
}

WORKTIME_BASE_URL="http://10.0.1.2:8000"
WORKTIME_STATE_CACHE="$HOME/.cache/worktime/state.json"
WORKTIME_PROJECTS_CACHE="$HOME/.cache/worktime/projects.json"
WORKTIME_POLL_INTERVAL=20
WORKTIME_PROJECTS_TTL=3600
WORKTIME_NOTES_CACHE="$HOME/.cache/worktime/notes.json"
WORKTIME_NOTES_MAX=7

get() { curl -s --connect-timeout 5 "$WORKTIME_BASE_URL$1"; }
post() { curl -s --connect-timeout 5 -H "Content-Type: application/json" -X POST -d "$2" "$WORKTIME_BASE_URL$1"; }

# Refreshes $WORKTIME_PROJECTS_CACHE (projects + shortcuts together, since
# both come from the same get_projects call) if stale; leaves an existing
# stale cache in place on fetch failure rather than erroring out.
_worktime_refresh_projects_cache() {
    local now cached_at response projects shortcuts
    now=$(date +%s)
    mkdir -p "$(dirname "$WORKTIME_PROJECTS_CACHE")"

    if [[ -f "$WORKTIME_PROJECTS_CACHE" ]]; then
        cached_at=$(jq -r '.cached_at // 0' "$WORKTIME_PROJECTS_CACHE")
        ((now - cached_at < WORKTIME_PROJECTS_TTL)) && return 0
    fi

    response=$(get "/worktime/projects")
    if [[ -z "$response" ]] || ! jq -e . >/dev/null 2>&1 <<<"$response"; then
        [[ -f "$WORKTIME_PROJECTS_CACHE" ]] && return 0
        return 1
    fi

    projects=$(jq -c '.service_response.projects // .projects' <<<"$response")
    shortcuts=$(jq -c '.service_response.shortcuts // .shortcuts // []' <<<"$response")
    jq -n --argjson projects "$projects" --argjson shortcuts "$shortcuts" --argjson cached_at "$now" \
        '{cached_at: $cached_at, projects: $projects, shortcuts: $shortcuts}' \
        >"$WORKTIME_PROJECTS_CACHE.tmp" && mv -f "$WORKTIME_PROJECTS_CACHE.tmp" "$WORKTIME_PROJECTS_CACHE"
}

worktime_fetch_projects() {
    _worktime_refresh_projects_cache || return 1
    jq -c '.projects' "$WORKTIME_PROJECTS_CACHE"
}

worktime_fetch_shortcuts() {
    _worktime_refresh_projects_cache || return 1
    jq -c '.shortcuts // []' "$WORKTIME_PROJECTS_CACHE"
}

# Per project/subproject-combo note history (a plain JSON cache file, not
# a real database) - last WORKTIME_NOTES_MAX distinct notes used, newest
# first, so the picker can offer them again instead of retyping.
worktime_notes_key() {
    printf '%s|%s' "$1" "$2"
}

worktime_notes_history() {
    local key="$1"
    [[ -f "$WORKTIME_NOTES_CACHE" ]] || {
        echo '[]'
        return 0
    }
    jq -c --arg key "$key" '.[$key] // []' "$WORKTIME_NOTES_CACHE"
}

worktime_notes_record() {
    local key="$1" note="$2"
    [[ -z "$note" ]] && return 0
    mkdir -p "$(dirname "$WORKTIME_NOTES_CACHE")"
    [[ -f "$WORKTIME_NOTES_CACHE" ]] || echo '{}' >"$WORKTIME_NOTES_CACHE"
    jq --arg key "$key" --arg note "$note" --argjson max "$WORKTIME_NOTES_MAX" \
        '.[$key] = ([$note] + ((.[$key] // []) - [$note]))[0:$max]' \
        "$WORKTIME_NOTES_CACHE" >"$WORKTIME_NOTES_CACHE.tmp" && mv -f "$WORKTIME_NOTES_CACHE.tmp" "$WORKTIME_NOTES_CACHE"
}

worktime_subproject_name() {
    local project_id="$1" subproject_id="$2" projects="$3"
    [[ -z "$subproject_id" || "$subproject_id" == "null" ]] && return 0
    jq -r --arg pid "$project_id" --arg sid "$subproject_id" \
        '(.[] | select(.id == $pid) | .subprojects[]? | select(.id == $sid) | .name) // $sid' \
        <<<"$projects"
}

notify_err() { notify-send "Worktime" "$1"; }

write_cache() {
    local state="$1" project_id="$2" subproject="$3" note="$4" start_iso
    start_iso=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    jq -n --arg polled_at "$(date +%s)" --arg state "$state" --arg project_id "$project_id" \
        --arg subproject "$subproject" --arg start "$start_iso" --arg note "$note" \
        '{polled_at: ($polled_at | tonumber), state: $state, project_id: $project_id,
          subproject: $subproject, start: $start, note: $note}' >"$WORKTIME_STATE_CACHE.tmp" &&
        mv -f "$WORKTIME_STATE_CACHE.tmp" "$WORKTIME_STATE_CACHE"
}

do_stop() {
    local response
    response=$(post "/worktime/stop" '{}')
    if [[ -z "$response" ]]; then
        notify_err "Failed to stop timer"
        exit 1
    fi
    rm -f "$WORKTIME_STATE_CACHE"
}

start_timer() {
    local project_id="$1" subproject_id="$2" label="$3" note="${4:-}" payload response
    payload=$(jq -nc --arg project_id "$project_id" --arg subproject "$subproject_id" --arg note "$note" \
        '{project_id: $project_id}
         + (if $subproject == "" then {} else {subproject: $subproject} end)
         + (if $note == "" then {} else {note: $note} end)')
    response=$(post "/worktime/start" "$payload")
    if [[ -z "$response" ]]; then
        notify_err "Failed to start $label"
        exit 1
    fi
    write_cache "$label" "$project_id" "$subproject_id" "$note"
}

# Waybar renders both text and tooltip as Pango markup, so any literal
# &/</> from a project/subproject name (e.g. "P&E") must be escaped or
# GTK silently rejects the markup and the module stops updating.
emit_status() {
    jq -nc --arg symbol "" --arg tooltip "$1" --arg class "$2" \
        'def esc: gsub("&"; "&amp;") | gsub("<"; "&lt;") | gsub(">"; "&gt;");
         {text: ($symbol | esc), tooltip: ($tooltip | esc), class: $class}'
}

do_status() {
    mkdir -p "$(dirname "$WORKTIME_STATE_CACHE")"
    local now stale=0 cached_at response state project_id subproject start note
    now=$(date +%s)

    cached_at=0
    [[ -f "$WORKTIME_STATE_CACHE" ]] && cached_at=$(jq -r '.polled_at // 0' "$WORKTIME_STATE_CACHE")

    if [[ ! -f "$WORKTIME_STATE_CACHE" ]] || ((now - cached_at >= WORKTIME_POLL_INTERVAL)); then
        response=$(get "/worktime")
        if [[ -n "$response" ]] && jq -e . >/dev/null 2>&1 <<<"$response"; then
            state=$(jq -r '.state' <<<"$response")
            project_id=$(jq -r '.attributes.project_id // empty' <<<"$response")
            subproject=$(jq -r '.attributes.subproject // empty' <<<"$response")
            start=$(jq -r '.attributes.start // empty' <<<"$response")
            note=$(jq -r '.attributes.note // empty' <<<"$response")
            jq -n --arg polled_at "$now" --arg state "$state" --arg project_id "$project_id" \
                --arg subproject "$subproject" --arg start "$start" --arg note "$note" \
                '{polled_at: ($polled_at | tonumber), state: $state, project_id: $project_id,
                  subproject: $subproject, start: $start, note: $note}' >"$WORKTIME_STATE_CACHE.tmp" &&
                mv -f "$WORKTIME_STATE_CACHE.tmp" "$WORKTIME_STATE_CACHE"
        else
            stale=1
        fi
    fi

    if [[ ! -f "$WORKTIME_STATE_CACHE" ]]; then
        emit_status "Idle - click to start" "idle"
        return 0
    fi

    state=$(jq -r '.state' "$WORKTIME_STATE_CACHE")
    project_id=$(jq -r '.project_id' "$WORKTIME_STATE_CACHE")
    subproject=$(jq -r '.subproject' "$WORKTIME_STATE_CACHE")
    start=$(jq -r '.start' "$WORKTIME_STATE_CACHE")
    note=$(jq -r '.note // empty' "$WORKTIME_STATE_CACHE")

    if [[ -z "$state" || "$state" == "idle" ]]; then
        if ((stale)); then
            emit_status "Idle (server down)" "stale"
        else
            emit_status "Idle" "idle"
        fi
        return 0
    fi

    local start_epoch elapsed elapsed_fmt subproject_name="" label started_local tooltip
    start_epoch=$(date -d "$start" +%s 2>/dev/null || echo "$now")
    elapsed=$((now - start_epoch))
    ((elapsed < 0)) && elapsed=0
    printf -v elapsed_fmt '%02d:%02d:%02d' $((elapsed / 3600)) $((elapsed % 3600 / 60)) $((elapsed % 60))

    if [[ -n "$subproject" ]]; then
        local projects
        projects=$(worktime_fetch_projects) || projects="[]"
        subproject_name=$(worktime_subproject_name "$project_id" "$subproject" "$projects")
    fi

    label="$state"
    [[ -n "$subproject_name" ]] && label="$state · $subproject_name"

    started_local=$(date -d "$start" '+%H:%M' 2>/dev/null || echo "$start")

    if [[ -n "$note" ]]; then
        tooltip="$note"$'\n'"$label"$'\n'"$started_local · $elapsed_fmt"
    else
        tooltip="$label"$'\n'"$started_local · $elapsed_fmt"
    fi

    if ((stale)); then
        emit_status "$tooltip"$'\n'"⚠ stale (server unreachable)" "stale"
    else
        emit_status "$tooltip" "running"
    fi
}

do_start() {
    local projects options=() choice project_id project subprojects default_subproject sub_count
    projects=$(worktime_fetch_projects) || {
        notify_err "Could not reach worktime server"
        exit 1
    }

    while IFS= read -r name; do
        options+=("$name")
    done < <(jq -r '.[] | select(.hidden | not) | .name' <<<"$projects")

    choice=$(printf '%s\n' "${options[@]}" | walker --dmenu) || exit 0
    [[ -z "$choice" ]] && exit 0

    project_id=$(jq -r --arg name "$choice" '.[] | select(.name == $name) | .id' <<<"$projects" | head -n1)
    project=$(jq -c --arg name "$choice" '.[] | select(.name == $name)' <<<"$projects" | head -n1)
    subprojects=$(jq -c '.subprojects' <<<"$project")
    default_subproject=$(jq -r '.default_subproject // ""' <<<"$project")
    sub_count=$(jq 'length' <<<"$subprojects")

    local subproject_id="" sub_names sub_choice
    if ((sub_count > 0)); then
        # Default subproject (if set) listed first, rest in their normal order.
        sub_names=$(jq -r --arg def "$default_subproject" \
            '(map(select(.id == $def)) + map(select(.id != $def))) | .[].name' <<<"$subprojects")
        sub_choice=$(printf '%s\n' "$sub_names" | walker --dmenu) || exit 0
        [[ -z "$sub_choice" ]] && exit 0
        subproject_id=$(jq -r --arg name "$sub_choice" '.[] | select(.name == $name) | .id' <<<"$subprojects" | head -n1)
    fi

    local notes_key note
    notes_key=$(worktime_notes_key "$project_id" "$subproject_id")
    note=$(worktime_notes_history "$notes_key" | jq -r '.[]' | walker --dmenu --placeholder "Note (optional)") || note=""

    start_timer "$project_id" "$subproject_id" "$choice" "$note"
    worktime_notes_record "$notes_key" "$note"
}

do_shortcuts_menu() {
    local shortcuts count names choice shortcut project_id subproject_id projects project_name
    shortcuts=$(worktime_fetch_shortcuts) || {
        notify_err "Could not reach worktime server"
        exit 1
    }
    count=$(jq 'length' <<<"$shortcuts")
    ((count == 0)) && exit 0

    names=$(jq -r '.[].name' <<<"$shortcuts")
    choice=$(printf '%s\n' "$names" | ~/dotfiles/.config/waybar/scripts/menu.py 2>/dev/null) || exit 0
    [[ -z "$choice" ]] && exit 0

    shortcut=$(jq -c --arg name "$choice" '.[] | select(.name == $name)' <<<"$shortcuts" | head -n1)
    project_id=$(jq -r '.project_id' <<<"$shortcut")
    subproject_id=$(jq -r '.subproject // ""' <<<"$shortcut")

    # Use the real project name, not the shortcut's nickname, so the
    # tooltip doesn't show e.g. "Morning updates" as if it were a project.
    projects=$(worktime_fetch_projects) || projects="[]"
    project_name=$(jq -r --arg pid "$project_id" '.[] | select(.id == $pid) | .name' <<<"$projects" | head -n1)
    [[ -z "$project_name" ]] && project_name="$project_id"

    start_timer "$project_id" "$subproject_id" "$project_name" "$choice"
}

mode="${1:-status}"
case "$mode" in
status) do_status ;;
start) do_start ;;
stop) do_stop ;;
shortcuts-menu) do_shortcuts_menu ;;
*)
    usage >&2
    notify_err "Unknown worktime mode: $mode"
    exit 1
    ;;
esac
