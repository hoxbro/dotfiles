{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "formatter": false,
  "lsp": {
    "pyright": {
      "disabled": true,
    },
  },
  "mcp": {
    "issuestore": {
      "type": "local",
      "command": ["holoviz", "issuestore", "serve"],
      "enabled": false,
      "timeout": 120000,
    },
  },
  "permission": {
    "issuestore_*": "allow",
  },
}
