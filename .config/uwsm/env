#!/usr/bin/env bash

date "+%H:%M" >/tmp/last-unlock
export BROWSER=librewolf
export LANG=en_DK.UTF-8

case "$(uname -n)" in
"framework")
    export XCURSOR_SIZE=24
    export HYPRCURSOR_SIZE=24
    export GDK_SCALE=2
    export HYPR_SCALE=2
    ;;
*)
    export XCURSOR_SIZE=12
    export HYPRCURSOR_SIZE=12
    export GDK_SCALE=1
    export HYPR_SCALE=1
    ;;
esac
